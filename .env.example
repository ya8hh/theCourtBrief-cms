# Copy to .env for Docker Compose. Generate unique random secrets, never deploy these placeholders.
DATABASE_USERNAME=court_news
DATABASE_NAME=court_news
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_SSL=false
DATABASE_POOL_MAX=10
APP_KEYS=replace-key-one,replace-key-two
ADMIN_JWT_SECRET=replace-with-a-64-character-random-secret
API_TOKEN_SALT=replace-with-a-64-character-random-secret
TRANSFER_TOKEN_SALT=replace-with-a-64-character-random-secret
ENCRYPTION_KEY=replace-with-a-64-character-random-secret
MEDIA_SIGNING_KEY=replace-with-a-64-character-random-secret
CMS_PUBLIC_URL=http://localhost:1337
CMS_URL=http://127.0.0.1:1337
SITE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=1337
TRUST_PROXY=false
MAX_UPLOAD_BYTES=26214400
UPLOAD_PROVIDER=local
STRAPI_TELEMETRY_DISABLED=true
# Optional private S3-compatible storage (UPLOAD_PROVIDER=aws-s3)
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Native integration creates and drops its own uniquely named court_news_test_* database.
# TEST_DATABASE_PORT=55432

# PDF worker: generate a separate random shared token, minimum 32 characters.
PROCESSOR_TOKEN=replace-with-a-64-character-random-secret
# External document processing is OFF unless explicitly enabled.
AI_ENABLED=false
OCR_ENABLED=false
OCR_LANGUAGE=eng
MAX_PDF_PAGES=1000
MAX_EXTRACTED_CHARS=10000000
EXTRACTION_TIMEOUT_SECONDS=120
EXTRACTION_MEMORY_MB=1024
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_CONTEXT_BYTES=64000
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TIMEOUT_SECONDS=90
MAX_AI_CALLS_PER_DOCUMENT=100
# Use current provider prices; blank means unpriced, never a fabricated zero.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_PRICE_CURRENCY=USD
MAX_AI_COST_PER_DOCUMENT=0
CONTACT_EMAIL=

# Optional real SMTP transport for native Strapi invitations/recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

EDITORIAL_URL=http://localhost:3001
